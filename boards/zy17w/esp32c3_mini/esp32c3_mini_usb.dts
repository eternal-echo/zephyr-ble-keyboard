 *
 * ESP32-C3-MINI (USB) — no CH340, uses built-in USB Serial/JTAG for console.
 * UART0 TX=GPIO20 drives WS2812B LED strip via worldsemi,ws2812-uart.
 */

/dts-v1/;

#include <espressif/esp32c3/esp32c3_fx4.dtsi>
#include "esp32c3_mini-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include <espressif/partitions_0x0_default.dtsi>

/ {
	model = "ESP32-C3-MINI (USB)";
	compatible = "zy17w,esp32c3_mini_usb";

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		led-strip = &led_strip;
		sw0 = &user_button1;
		watchdog0 = &wdt0;
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button1: button_1 {
			label = "BOOT";
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	led_pwr: led-pwr-ctrl {
		compatible = "regulator-fixed";
		regulator-name = "led-pwr-ctrl";
		enable-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		regulator-boot-off;
	};
};

&spi2 {
	status = "disabled";
};

&usb_serial {
	status = "okay";
};

&i2c0 {
	status = "disabled";
};

&trng0 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <2500000>;
	data-bits = <7>;
	stop-bits = "1";
	parity = "none";
	tx-invert;
	pinctrl-0 = <&uart0_ws2812>;
	pinctrl-names = "default";
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "rx", "tx";

	led_strip: ws2812-strip {
		compatible = "worldsemi,ws2812-uart";
		one-symbol = <0x6>;
		zero-symbol = <0x4>;
		bits-per-symbol = <3>;
		chain-length = <17>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <80>;
	};
};

&dma {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};